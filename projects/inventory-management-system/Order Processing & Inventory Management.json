    {
      "parameters": {
        "jsCode": "\nconst inventory = $input.all().map(item => item.json);\n\nconst order = $('On form submission').first().json;\n\nconst product = inventory.find(item =>\n  String(item.product_id).trim() ===\n  String(order.product_id).trim()\n);\n\nconst quantity = Number(order.quantity);\n\nconst quantityValid =\n  Number.isInteger(quantity) && quantity > 0;\n\nconst stock = product\n  ? Number(product.stock_quantity)\n  : 0;\n\nconst price = product\n  ? Number(product.price)\n  : 0;\n\nlet reason = '';\n\nif (!product) {\n  reason = 'Product not found';\n} else if (!quantityValid) {\n  reason = 'Invalid quantity';\n} else if (quantity > stock) {\n  reason = 'Insufficient stock';\n}\n\nconst accepted = reason === '';\n\nreturn [\n  {\n    json: {\n      ...order,\n      product_found: !!product,\n      quantity_valid: quantityValid,\n      available_stock: stock,\n      unit_price: price,\n      total_price: accepted ? price * quantity : 0,\n      order_status: accepted ? 'Accepted' : 'Rejected',\n      rejection_reason: reason\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
