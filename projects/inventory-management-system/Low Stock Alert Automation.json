    {
      "parameters": {
        "jsCode": "const inventory = $('Get row(s) in sheet').all()\n  .map(item => item.json);\n\nconst alerts = $input.all().map(item => item.json);\n\nconst lowStockProducts = inventory.filter(product => {\n  const stock = Number(product.stock_quantity);\n  const minimum = Number(product.minimum_stock);\n\n  return (\n    product.product_id &&\n    Number.isFinite(stock) &&\n    Number.isFinite(minimum) &&\n    stock <= minimum\n  );\n});\n\nconst newAlerts = lowStockProducts.filter(product => {\n  return !alerts.some(alert =>\n    String(alert.product_id).trim() ===\n      String(product.product_id).trim() &&\n    alert.alert_status === 'Low Stock' &&\n    String(alert.resolved).trim().toLowerCase() !== 'yes'\n  );\n});\n\nreturn newAlerts.map(product => ({\n  json: {\n    product_id: product.product_id,\n    product_name: product.product_name,\n    remaining_stock: Number(product.stock_quantity),\n    minimum_stock: Number(product.minimum_stock),\n    alert_status: 'Low Stock',\n    resolved: 'No'\n  }\n}));"
      },
